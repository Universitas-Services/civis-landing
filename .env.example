# Landing pública — configuración
# Copiar a .env.local:  cp .env.example .env.local
#
# Sólo variables NEXT_PUBLIC_*: esta aplicación no maneja ningún secreto.
# No consume endpoints autenticados ni tiene acceso a la base de datos.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_DOCUMENT_ORIGIN=http://localhost:9000
NEXT_PUBLIC_SITE_NAME="Consejo Independiente de Verificación de Credenciales"
NEXT_PUBLIC_SITE_SHORT_NAME=CIVIS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido con la API para invalidar la caché tras una publicación.
# Debe coincidir con REVALIDATE_SECRET del backend.
# CHANGE_ME: generar con `openssl rand -base64 32`
REVALIDATE_SECRET=CHANGE_ME_secreto_de_revalidacion
